[options]
mode bmc
depth 4
multiclock off

[engines]
smtbmc bitwuzla

[script]
read_verilog -sv ../rtl/addr_map_pkg.sv
read_verilog -sv ../rtl/addr_map_xor.sv
read_verilog -sv ../rtl/addr_map_region_table.sv
read_verilog -sv ../rtl/addr_map_reg_top.sv
read_verilog -sv ../rtl/addr_map.sv
prep -top addr_map

[files]
../rtl/addr_map_pkg.sv
../rtl/addr_map_xor.sv
../rtl/addr_map_region_table.sv
../rtl/addr_map_reg_top.sv
../rtl/addr_map.sv
