[options]
mode bmc
depth 4
multiclock off

[engines]
smtbmc bitwuzla

[script]
exec -- sh -c "sv2v -DOPENHBM_FPV addr_map_pkg.sv addr_map_xor.sv addr_map_region_table.sv addr_map_reg_top.sv addr_map.sv > addr_map_bound_flat.v"
verilog_defines -D OPENHBM_FPV
read_verilog addr_map_bound_flat.v
prep -top addr_map

[files]
addr_map_pkg.sv hw/ip/addr_map/rtl/addr_map_pkg.sv
addr_map_xor.sv hw/ip/addr_map/rtl/addr_map_xor.sv
addr_map_region_table.sv hw/ip/addr_map/rtl/addr_map_region_table.sv
addr_map_reg_top.sv hw/ip/addr_map/rtl/addr_map_reg_top.sv
addr_map.sv hw/ip/addr_map/rtl/addr_map.sv
