[options]
mode bmc
depth 8
multiclock off

[engines]
smtbmc bitwuzla

[script]
exec -- sh -c "sv2v -DOPENHBM_FPV addr_map_pkg.sv addr_map_xor.sv > addr_map_inj_flat.v"
verilog_defines -D OPENHBM_FPV
read_verilog addr_map_inj_flat.v
prep -top addr_map_xor

[files]
addr_map_pkg.sv hw/ip/addr_map/rtl/addr_map_pkg.sv
addr_map_xor.sv hw/ip/addr_map/rtl/addr_map_xor.sv
