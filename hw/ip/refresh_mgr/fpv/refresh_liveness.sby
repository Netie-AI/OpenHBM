[options]
mode bmc
depth 12
timeout 600
multiclock off

[engines]
smtbmc bitwuzla

[script]
exec -- sh -c "sv2v -DOPENHBM_FPV wrapper.sv abs.sv refresh_mgr_pkg.sv refresh_mgr.sv > refresh_liveness_flat.v"
verilog_defines -D OPENHBM_FPV
read_verilog refresh_liveness_flat.v
prep -top refresh_mgr_liveness_wrapper

[files]
refresh_mgr_pkg.sv hw/ip/refresh_mgr/rtl/refresh_mgr_pkg.sv
refresh_mgr.sv hw/ip/refresh_mgr/rtl/refresh_mgr.sv
abs.sv hw/ip/refresh_mgr/fpv/abs_bank_machine.sv
wrapper.sv hw/ip/refresh_mgr/fpv/refresh_liveness.sv
