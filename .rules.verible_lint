# Verible lint rules for Netie Open HBM
# Rules deliberately enabled to enforce CLAUDE.md style.
# See: https://chipsalliance.github.io/verible/lint.html

# Naming
+module-filename
+package-filename-suffix
+enum-name-style
+parameter-name-style
+typedef-enums
+typedef-structs-unions

# Style
+line-length=100
+no-tabs
+no-trailing-spaces
+posix-eof
+v2001-generate-begin

# Always-block discipline (CLAUDE.md s1.2)
+always-comb
+always-comb-blocking
+always-ff-non-blocking

# Hazardous constructs banned in CLAUDE.md s1.2
-disable-statement
+forbidden-anonymous-enums
+forbidden-symbols=$random,$urandom,$urandom_range,defparam

# Reset / clock discipline
+explicit-begin
+explicit-parameter-storage-type
+explicit-task-lifetime
+explicit-function-lifetime

# Structural
+endif-comment
+module-begin-block
+package-filename-suffix
+struct-union-name-style
+suggest-parentheses
+truncated-numeric-literal
+undersized-binary-literal
+unpacked-dimensions-range-ordering
